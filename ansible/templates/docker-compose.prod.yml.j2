version: '3.8'

services:
  bot:
    build: .
    container_name: career_bot
    restart: always
    env_file: .env
    depends_on:
      - postgres
      - redis
    volumes:
      - ./:/app
    command: python main.py

  postgres:
    image: postgres:16-alpine
    container_name: career_db
    restart: always
    environment:
      POSTGRES_USER: career_user
      POSTGRES_PASSWORD: career_pass
      POSTGRES_DB: career_db
    volumes:
      - pgdata:/var/lib/postgresql/data
      - ./db/init.sql:/docker-entrypoint-initdb.d/init.sql:ro
    ports:
      - "127.0.0.1:5432:5432"

  redis:
    image: redis:7-alpine
    container_name: career_redis
    restart: always
    ports:
      - "127.0.0.1:6379:6379"

volumes:
  pgdata:
